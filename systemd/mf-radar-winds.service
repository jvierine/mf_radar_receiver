[Unit]
Description=Estimate realtime three-dipole MF radar Doppler
After=network-online.target

[Service]
Type=oneshot
User=radar
WorkingDirectory=/home/radar/src/mf_radar_receiver
Environment=MPLBACKEND=Agg
ExecStart=/home/radar/drf/bin/python /home/radar/src/mf_radar_receiver/plot_realtime_dense_doppler.py
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
